+def _parse_max_speed(value: str) -> float:
+    """--max-speed value: km/h as float, or 'unlimited' (autobahn, no limit).
+
+    <= 7 (e.g. 5) means Schrittgeschwindigkeit / parking lot; the engine
+    snaps other values to the nearest German speed class in-graph.
+    """
