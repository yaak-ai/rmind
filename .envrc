if command -v nom >/dev/null 2>&1; then
  use flake . --log-format internal-json 2> >(nom --json)
else
  use flake .
fi

# On NixOS the GPU driver libs live in /run/opengl-driver/lib (handled by the flake's
# TRITON_LIBCUDA_PATH). On a non-NixOS host that path is absent and the nix-glibc Python
# can't find the system libcuda.so.1, so torch reports no GPU and Triton fails to link.
# Expose a driver-only lib dir (deliberately NO libc, which would shadow nix's glibc)
# via the nix-ld hook (NIX_LD_LIBRARY_PATH, appended by the flake's wrapped `uv`) and
# Triton's link path (TRITON_LIBCUDA_PATH, overriding the flake default set above).
if [ ! -d /run/opengl-driver/lib ]; then
  cudalibs="${XDG_CACHE_HOME:-$HOME/.cache}/rmind/cudalibs"
  mkdir -p "$cudalibs"
  for soname in libcuda.so.1 libnvidia-ml.so.1; do
    src=$(readlink -f "/usr/lib/x86_64-linux-gnu/$soname" 2>/dev/null)
    [ -n "$src" ] && [ -e "$src" ] && ln -sf "$src" "$cudalibs/$soname"
  done
  if [ -e "$cudalibs/libcuda.so.1" ]; then
    export NIX_LD_LIBRARY_PATH="$cudalibs${NIX_LD_LIBRARY_PATH:+:$NIX_LD_LIBRARY_PATH}"
    export TRITON_LIBCUDA_PATH="$cudalibs"
  fi
fi
